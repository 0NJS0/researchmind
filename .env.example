# ResearchMind configuration. Copy to .env and fill in. Never commit .env.

# ── LLM (OpenRouter) ──
LLM_PROVIDER=openrouter                   # openrouter | openai (any OpenAI-compatible server) | anthropic
LLM_API_KEY=<your-openrouter-api-key>     # from openrouter.ai/keys (starts with sk-or-) — stays server-side
LLM_MODEL=<main-model-id>                 # e.g. nvidia/nemotron-3-ultra-550b-a55b:free (best free model for paper reading, benchmarked 2026-09)
# Comma-separated models tried when the main one is rate limited or unavailable
LLM_FALLBACK_MODELS=<fallback-model-id-1>,<fallback-model-id-2>
LLM_FAST_MODEL=<fast-model-id>            # quicker model for relevance screening, e.g. nvidia/nemotron-3-super-120b-a12b:free
# LLM_FREE_ONLY=true                      # refuse any model id not ending in ':free' (default for openrouter)
# LLM_URL=                                # defaults to https://openrouter.ai/api/v1 for openrouter
# LLM_CONTEXT_TOKENS=32768                # prompts are budgeted to fit this window
# LLM_MAX_OUTPUT_TOKENS=4096
# LLM_REASONING=exclude                   # exclude | low | off  (most free models are reasoning models)
# LLM_MIN_INTERVAL=3.5                    # seconds between requests (free tier: ~20 requests/minute)
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT=180
# LLM_CACHE=true                          # cache validated structured outputs in Postgres
# OPENROUTER_APP_URL=                     # optional OpenRouter attribution

# ── Embeddings (OpenRouter by default; uses LLM_API_KEY unless EMBEDDING_API_KEY is set) ──
EMBEDDING_MODEL=<embedding-model-id>      # e.g. nvidia/nemotron-3-embed-1b:free
# EMBEDDING_URL=                          # defaults to LLM_URL
# EMBEDDING_API_KEY=<your-embedding-api-key>
# EMBEDDING_BATCH_SIZE=32
# Changing EMBEDDING_MODEL later requires re-indexing (Library → Re-index all).

# ── PostgreSQL + pgvector (homelab) ──
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
# DB_SCHEMA=
# DB_POOL_MAX=10

# ── Web search for the research agent (homelab SearXNG) ──
SEARXNG_URL=http://<searxng-host>:<port>   # enable `json` under search.formats in SearXNG's settings.yml
# SEARXNG_CATEGORIES=science
# SEARXNG_ENGINES=                        # comma-separated; empty = instance defaults

# ── Files ──
PAPERS_DIR=./papers                       # used when running outside Docker; the container always uses /data/papers
# PAPERS_HOST_DIR=/path/on/host/to/papers  # Docker: host folder mounted as /data/papers (default ./data/papers)

# ── API ──
# CORS_ORIGINS=http://localhost:5173     # only needed when the UI runs on another origin (Vite dev server)

# ── Autopilot (continuous research on the active topic) ──
# AUTOPILOT_ENABLED=true
# AUTOPILOT_RESEARCH_INTERVAL_HOURS=12     # wait this long before searching again when nothing new was found
# AUTOPILOT_QUOTA_RESERVE=250              # free requests/day the autopilot leaves for Ask and manual use
# AUTOPILOT_MIN_RELEVANCE=0.5
# AUTOPILOT_MAX_PAPERS_PER_TOPIC=300
# NARRATIVE_EVERY=5                        # rewrite the living report's narrative every N new papers
# OPENALEX_ENABLED=true                    # citations, peer-review status and open-access PDFs for ranking
# OPENALEX_API_KEY=<your-openalex-api-key> # optional free key from openalex.org/settings/api: 10,000 credits/day (vs 1,000)
# OPENALEX_EMAIL=<you@example.com>        # optional: identifies you to OpenAlex
# RANK_W_RELEVANCE=0.45
# RANK_W_RECENCY=0.25
# RANK_W_IMPACT=0.20
# RANK_W_VENUE=0.10

# ── Research agent limits ──
# MAX_SEARCH_ITERATIONS=3
# MAX_RESULTS_PER_QUERY=20
# MAX_PAPERS_PER_SESSION=30
# MAX_QUERIES_PER_ITERATION=6
# MAX_LLM_RELEVANCE_CHECKS=30
# MAX_CONTENT_CHUNKS=3
# ENABLE_PAPER_COMPARISON=true
# ALLOW_PRIVATE_FETCH=false               # allow fetching paper URLs on private/LAN addresses
